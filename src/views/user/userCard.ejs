<article class="user-card">

    <h3><%= user.username %></h3>

    <p>Email: <%= user.email %></p>
    <p>Rol: <%= user.rol %></p>

    <div>
        <% if (locals.mostrarVisitar !== false) { %>
            <a href="/user/<%= user.id_user %>">Visitar</a>
        <% } %>

        <% if (authUser && (authUser.rol === "admin" || Number(authUser.id_user) === Number(user.id_user))) { %>
            <a href="/user/<%= user.id_user %>/update">Editar</a>
        <% } %>


        <% if (authUser && authUser.rol === "admin") { %>

            <form method="post" action="/user/<%= user.id_user %>/delete">
                <button type="submit">Eliminar</button>
            </form>
        <% } %>

    </div>
    

</article>