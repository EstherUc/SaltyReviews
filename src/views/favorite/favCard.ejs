<article class="favorite-card">
    <div class="card-left">
        <img src="https://placehold.co/400" alt="">
        <form action="/favorite/<%= favorite.id_favorites %>/delete" method="POST">

            <button id="fav-btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
                    class="icon icon-tabler icons-tabler-filled icon-tabler-heart">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path
                        d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z" />
                </svg>
            </button>

        </form>

    </div>
    <div class="card-right">

        <h2>
            <%= favorite.restaurant.name_restaurant %>
        </h2>                    
                <p>Dirección: <%= favorite.restaurant.address %>
                </p>

                <p>
                Puntuación:
                <% if (favorite.restaurant.averageRating !==null) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="gold"
                        stroke="gold" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z" />
                    </svg>

                    <%= Number(favorite.restaurant.averageRating).toFixed(1) %>
                        <% } else { %>
                            Sin valoraciones
                            <% } %>
            </p>
            <a id="ver-restaurant-btn" href="/restaurant/<%= favorite.restaurant.id_restaurant %>">
                Ver restaurante
            </a>
       

    </div>

</article>