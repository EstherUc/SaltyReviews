<article class="restaurant.card">
    <div class="card-left">
        <img src="https://placehold.co/400" alt="">
<form action="/favorite/<%= restaurant.id_restaurant %>/create" method="POST"></form>

            <button id="delete-fav-btn" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-heart">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
                </svg>
            </button>
</form>
        
    </div>
    <div class="card-right">

        <h3>
            <%= restaurant.name_restaurant %>
        </h3>

<p>Dirección: <%= restaurant.address %></p>
        <p>
    Puntuación:
    <% if (restaurant.averageRating !== null) { %>
        <%= Number(restaurant.averageRating).toFixed(1) %> ⭐
    <% } else { %>
        Sin valoraciones
    <% } %>
</p>


    </div>




</article>