<%- include('../layout/header', { title: restaurant ? restaurant.name_restaurant : 'Restaurante no encontrado' }); -%>

<% if (restaurant) { %>

    <h1><%= restaurant.name_restaurant %></h1>

    <section>
        <h3>Información del restaurante</h3>

        <p>Nombre: <%= restaurant.name_restaurant %></p>
        <p>Dirección: <%= restaurant.address %></p>
        <p>Categoría: <%= restaurant.id_category %></p>
    </section>

<% } else { %>
    <p>No existe el restaurante</p>
<% } %>

<a href="/restaurant">Volver</a>

<%- include('../layout/footer'); -%>