<%- include('../layout/header'); -%>

<main>

    <h1>Editar restaurante</h1>

    <section>
        <h2>Datos del restaurante</h2>

        <%- include('../layout/error') -%>

        <form action="/restaurant/<%= restaurant.id_restaurant %>/update" method="POST">

            <div>
                <label for="name_restaurant">Nombre del restaurante:</label>
                <input
                    type="text"
                    id="name_restaurant"
                    name="name_restaurant"
                    value="<%= restaurant.name_restaurant %>"
                    maxlength="100"
                    required
                >
            </div>

            <div>
                <label for="address">Dirección:</label>
                <input
                    type="text"
                    id="address"
                    name="address"
                    value="<%= restaurant.address %>"
                    maxlength="150"
                    required
                >
            </div>

            <div>
                <label for="id_category">Categoría:</label>
                <select id="id_category" name="id_category" required>
                    <% for (const category of categories) { %>
                        <option
                            value="<%= category.id_category %>"
                            <%= Number(category.id_category) === Number(restaurant.id_category) ? 'selected' : '' %>
                        >
                            <%= category.name_category %>
                        </option>
                    <% } %>
                </select>
            </div>

            <button type="submit">Guardar cambios</button>

        </form>
    </section>

    <a href="/restaurant/<%= restaurant.id_restaurant %>">Volver al restaurante</a>

</main>

<%- include('../layout/footer'); -%>
