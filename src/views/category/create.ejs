<%- include('../layout/header'); -%>

    <main>

        <h1>Crear categoria</h1>

        <section>

            <h2>Datos de la nueva categoria</h2>

            <%- include('../layout/error') -%>

                <% if (query.message) { %>
                    <p class="success">
                        <%= query.message %>
                    </p>
                    <% } %>

                        <form action="/category" method="post">

                            <div>
                                <label for="name_category">Nombre de la categoria</label>
                                <input type="text" name="name_category" id="name_category" required>
                            </div>

                            <button>Crear</button>

                        </form>

        </section>

        <a href="/category">Volver</a>

    </main>

    <%- include('../layout/footer'); -%>