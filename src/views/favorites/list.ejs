<main style="padding: 20px;">
    <h1>Mis Restaurantes Favoritos</h1>

    <!-- Botón para borrar todos -->
    <% if (favorites && favorites.length > 0) { %>
        <form action="/favorites/delete-all" method="POST" style="margin-bottom: 20px;">
            <button type="submit" onclick="return confirm('¿Vaciar todos tus favoritos?')">
                Borrar todos los favoritos
            </button>
        </form>

        <!-- Listado de favoritos -->
        <ul>
            <% favorites.forEach(fav => { %>
                <li style="margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
                    <strong><%= fav.restaurant ? fav.restaurant.name : 'Restaurante desconocido' %></strong>
                    <br>
                    <span>Estado: <%= fav.want_to_visit ? "Pendiente de visitar" : "Ya visitado" %></span>

                    <div style="display: flex; gap: 10px; margin-top: 5px;">
                        <!-- Botón para cambiar estado (Toggle) -->
                        <form action="/favorites/<%= fav.id_favorites %>/toggle" method="POST">
                            <button type="submit">
                                Marcar como <%= fav.want_to_visit ? "Visitado" : "Pendiente" %>
                            </button>
                        </form>

                        <!-- Botón para eliminar favorito -->
                        <form action="/favorites/<%= fav.id_favorites %>/delete" method="POST">
                            <button type="submit">Eliminar</button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No tienes ningún restaurante guardado en favoritos todavía.</p>
    <% } %>

    <hr>

    <!-- Formulario rápido de prueba para añadir favorito -->
    <h3>Añadir favorito por ID</h3>
    <form action="/favorites" method="POST">
        <label for="id_restaurant">ID del Restaurante (ej. 1, 2, 3):</label>
        <input type="number" id="id_restaurant" name="id_restaurant" required>
        <button type="submit">Guardar en favoritos</button>
    </form>
</main>

