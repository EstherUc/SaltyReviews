<h1>Mis favoritos</h1>

<% if (favorites.length > 0) { %>

    <form action="/favorite/user/<%= userId %>/delete" method="POST">

        <button type="submit">Eliminar todos mis favoritos</button>

    </form>

<% } %>

<% if (favorites.length===0) { %>

    <p>Todavía no tienes restaurantes favoritos.</p>

    <% } else { %>

        <% favorites.forEach(favorite=> { %>

            <div class="favorite-card">

                <h2><%= favorite.restaurant.name %></h2>

                <p><%= favorite.restaurant.address %></p>

                <form action="/favorite/<%= favorite.id %>/delete" method="POST">

                    <button type="submit">Eliminar de favoritos</button>

                </form>

            </div>

            <% }); %>

                <% } %>

        