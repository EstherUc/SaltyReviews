<%- include('../layout/header'); -%>

    <main>

        <h1>Actualizar reseña</h1>

        <section>

            <h2>Editar reseña</h2>

            <!-- MENSAJES DE ERROR -->
            <%- include('../layout/error') -%>

                <form action="/review/<%= review.id_reviews %>/update" method="POST">

                    <!-- TÍTULO -->
                    <div>
                        <label for="title">
                            Título
                        </label>

                        <input type="text" name="title" id="title" maxlength="100" value="<%= review.title %>" required>
                    </div>

                    <!-- PUNTUACIÓN -->
                    <div>
                        <label for="rating">
                            Puntuación
                        </label>

                        <input type="number" name="rating" id="rating" min="1" max="5" step="1"
                            value="<%= review.rating %>" required>
                    </div>

                    <!-- COMENTARIO -->
                    <div>
                        <label for="comment">
                            Comentario
                        </label>

                        <textarea id="comment" name="comment" maxlength="300" required><%= review.comment %></textarea>
                    </div>

                    <button type="submit">
                        Guardar cambios
                    </button>

                </form>

        </section>

        <a href="/review/<%= review.id_reviews %>">
            Volver a la reseña
        </a>

    </main>

    <%- include('../layout/footer'); -%>