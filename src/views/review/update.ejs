<h2>Actualizar review:</h2>

<form action="/review/<%= review.id_reviews %>/edit" method="post">

    <label for="title">Título</label>
    <input type="text" name="title" id="title" value="<%= review.title %>" required>

    <label for="rating">Puntuación</label>
    <input type="number" name="rating" id="rating" min="1" max="5" value="<%= review.rating %>" required>

    <label for="comment">Comentarios</label>
    <textarea id="comment" name="comment" required><%= review.comment %></textarea>

    <button type="submit">Guardar cambios</button>
</form>