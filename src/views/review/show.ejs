                            </a>

                            <% if (authUser && authUser.rol==="admin" ) { %>

                                <a href="/review">
                                    Volver al panel de reseñas
                                </a>

                                <% } %>

                                    <% } %>
                                        <%- include('../layout/footer'); -%>