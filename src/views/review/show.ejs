<%- include('../layout/header'); -%>
    <%- include('../layout/error') -%>
        <% if(review){%>
            <%- include('reviewCard',{review}) -%>

                <% } else if (!locals.error) { %>
                    <p>No existe la reseña</p>
                    <% } %>

                        <% if (review) { %>

                            <a href="/restaurant/<%= review.id_restaurant %>">
