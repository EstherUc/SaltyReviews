<article class="review-card">
    <h3>
        <%= review.title %>
    </h3>
    <p>Autor: <%= review.user.username %></p>
    <p>Puntuación: <%= review.rating %>
    </p>
    <p>Comentarios: <%= review.comment %>
    </p>

    <% if (authUser && (authUser.rol === "admin" || Number(authUser.id_user) === Number(review.id_user))) { %>

        <a href="/review/<%= review.id_reviews %>/update">Modificar</a>
        
        <form action="/review/<%= review.id_reviews %>/delete" method="post">
            <button type="submit">Eliminar</button>
        </form>
    
    <% } %>
</article>