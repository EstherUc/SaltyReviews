<% const reviewData=locals.formData || {}; %>

    <h2>Escribir una reseña</h2>

    <!-- Mostrar errores -->
    <%- include('../layout/error') -%>

        <form action="/review" method="POST">

            <!-- ID del restaurante -->
            <input type="hidden" name="id_restaurant" value="<%= restaurant.id_restaurant %>">

            <!-- TÍTULO -->
            <div>
                <label for="title">Título</label>

                <input type="text" name="title" id="title" maxlength="100" value="<%= reviewData.title || '' %>"
                    required>
            </div>

            <!-- PUNTUACIÓN -->
            <div>
                <label for="rating">Puntuación</label>

                <input type="number" name="rating" id="rating" min="1" max="5" step="1"
                    value="<%= reviewData.rating || '' %>" required>
            </div>

            <!-- COMENTARIO -->
            <div>
                <label for="comment">Comentario</label>

                <textarea id="comment" name="comment" maxlength="300"
                    required><%= reviewData.comment || '' %></textarea>
            </div>

            <button type="submit">
                Publicar reseña
            </button>

        </form>