<%- include('../layout/header'); -%>

    <main>

        <h1>Administrar reseñas</h1>

        <%- include('../layout/error') -%>

            <% if (query.message) { %>
                <p class="success">
                    <%= query.message %>
                </p>
                <% } %>

                    <% if (reviews.length===0) { %>

                        <p>No hay reseñas registradas.</p>

                        <% } else { %>

                            <% for (const review of reviews) { %>

                                <%- include('reviewCard', { review }) -%>

                                    <% } %>

                                        <% } %>

    </main>

    <%- include('../layout/footer'); -%>