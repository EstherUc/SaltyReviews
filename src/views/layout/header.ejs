<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SaltyReviews</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/variables.css">
</head>

<body>
    <header class="site-header">


        <nav class="navbar">

            <h1><a href="/home" class="navbar-logo">SaltyReviews</a></h1>


            <ul class="navbar-links">

                <li><a href="/restaurant">Restaurantes</a></li>

                <% if (authUser && authUser.rol==="admin" ) { %>
                    <li><a href="/user">Gestionar usuarios</a></li>
                    <li><a href="/review">Gestionar reseñas</a></li>
                    <li><a href="/category">Gestionar categorías</a></li>
                <% } %>
                <% if(!authUser){ %>
                    <li><a href="/auth/login">Iniciar sesión</a></li>
                <% }else{ %>
                    <li><a href="/user/<%= authUser.id_user %>">Mi perfil</a></li>
                    <li><a href="/favorite">Favoritos</a></li>
                    <li>
                        <form action="/auth/logout" method="post">
                            <button type="submit">Cerrar sesión</button>
                        </form>
                    </li>
                <%}%>

            </ul>
        </nav>
    </header>